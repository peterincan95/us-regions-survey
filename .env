# Public, non-secret settings. Both values end up in the browser anyway.
# Put local overrides in .env.local (git-ignored).

# Public web map from your organization (dark basemap recommended)
VITE_WEBMAP_ID=31284832c3fd49bd8c872cf77c8a4ec4

# URL of the PUBLIC, add-only hosted feature layer VIEW, including the layer index.
# Never the private source layer.
# e.g. https://services.arcgis.com/<org>/arcgis/rest/services/<view>/FeatureServer/0
VITE_FEATURE_LAYER_URL=https://services8.arcgis.com/X7s3vonljYk6kgvJ/arcgis/rest/services/US_Regions_Input_ViewLayer/FeatureServer/0

# Only needed if the web map lives on a portal other than www.arcgis.com
VITE_PORTAL_URL=
